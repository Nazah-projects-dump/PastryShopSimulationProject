<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="team.nazah.customer.PaymentScreenController">
   <children>
      <Label fx:id="paymentScreenOrderIdLabel" layoutX="87.0" layoutY="80.0" prefHeight="26.0" prefWidth="131.0" text="Order ID : " />
      <Label fx:id="paymentScreenTotalLabel" layoutX="87.0" layoutY="125.0" prefHeight="26.0" prefWidth="213.0" text="Total Payable Amount :" />
      <Button layoutX="153.0" layoutY="337.0" mnemonicParsing="false" onAction="#payNowButtonOnAction" text="Pay Now" />
      <Label fx:id="paymentStatusLabel" layoutX="312.0" layoutY="341.0" text="Payment Pending" />
      <Label layoutX="87.0" layoutY="176.0" text="Choose payment Method : " />
      <RadioButton fx:id="paymentMethodCashRadioButton" layoutX="87.0" layoutY="219.0" mnemonicParsing="false" text="Cash" />
      <RadioButton fx:id="paymentMethodCardRadioButton" layoutX="87.0" layoutY="251.0" mnemonicParsing="false" text="Card" />
      <Label layoutX="309.0" layoutY="251.0" text="Card Number :" />
      <Label layoutX="309.0" layoutY="276.0" text="Card Pin :" />
      <TextField fx:id="cardNumberTextField" layoutX="400.0" layoutY="247.0" />
      <TextField fx:id="cardPinTextField" layoutX="400.0" layoutY="281.0" />
      <Button layoutX="524.0" layoutY="350.0" mnemonicParsing="false" onAction="#backButtonOnAction" text="Back" />
   </children>
</AnchorPane>
