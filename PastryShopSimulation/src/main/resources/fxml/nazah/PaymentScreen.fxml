<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="team.nazah.customer.PaymentScreenController">
   <children>
      <Label fx:id="paymentScreenOrderIdLabel" layoutX="87.0" layoutY="80.0" prefHeight="26.0" prefWidth="131.0" text="Order ID : " />
      <Label fx:id="paymentScreenTotalLabel" layoutX="87.0" layoutY="125.0" prefHeight="26.0" prefWidth="213.0" text="Total Payable Amount :" />
      <Button layoutX="446.0" layoutY="309.0" mnemonicParsing="false" onAction="#payNowButtonOnAction" prefHeight="40.0" prefWidth="78.0" text="Pay Now" />
      <Label layoutX="87.0" layoutY="176.0" text="Choose payment Method : " />
      <RadioButton fx:id="paymentMethodCashRadioButton" layoutX="87.0" layoutY="219.0" mnemonicParsing="false" onAction="#paymentMethodOnAction" text="Cash" />
      <RadioButton fx:id="paymentMethodCardRadioButton" layoutX="87.0" layoutY="251.0" mnemonicParsing="false" onAction="#paymentMethodOnAction" text="Card" />
      <Label fx:id="cardNumberLabel" layoutX="295.0" layoutY="210.0" text="Card Number :" />
      <Label fx:id="cardPinLabel" layoutX="308.0" layoutY="251.0" text="Card Pin :" />
      <TextField fx:id="cardNumberTextField" layoutX="385.0" layoutY="206.0" />
      <TextField fx:id="cardPinTextField" layoutX="385.0" layoutY="247.0" />
      <Label alignment="CENTER" layoutX="36.0" layoutY="25.0" prefHeight="40.0" prefWidth="157.0" style="-fx-background-color: pink;" text="Payment" />
   </children>
</AnchorPane>
