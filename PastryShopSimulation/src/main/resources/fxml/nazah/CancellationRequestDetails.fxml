<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="team.nazah.cashier.CancellationRequestDetailsController">
   <children>
      <Label alignment="CENTER" layoutX="22.0" layoutY="24.0" prefHeight="39.0" prefWidth="182.0" style="-fx-background-color: pink;" text="Cancellation Request" />
      <Label fx:id="orderDetailslabel" alignment="CENTER" layoutX="35.0" layoutY="95.0" prefHeight="142.0" prefWidth="192.0" style="-fx-border-color: pink;" />
      <Label layoutX="277.0" layoutY="86.0" text="Reason for cancellation :" />
      <TextField fx:id="reasonTextField" layoutX="274.0" layoutY="114.0" prefHeight="50.0" prefWidth="218.0" />
      <Button layoutX="274.0" layoutY="188.0" mnemonicParsing="false" onAction="#confirmButtonOnAction" prefHeight="156.0" prefWidth="218.0" text="Confirm Cancellation and Refund" />
      <Label fx:id="refundAmountLabel" alignment="CENTER" layoutX="35.0" layoutY="258.0" prefHeight="86.0" prefWidth="192.0" style="-fx-border-color: pink;" text="Refundable amount : " />
      <Button layoutX="528.0" layoutY="352.0" mnemonicParsing="false" onAction="#backButtonOnAction" text="Back" />
   </children>
</AnchorPane>
