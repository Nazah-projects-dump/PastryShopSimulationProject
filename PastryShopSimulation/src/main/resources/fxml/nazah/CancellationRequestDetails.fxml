      <Label fx:id="orderIdlabel" layoutX="57.0" layoutY="95.0" text="Order ID : " />
      <Label fx:id="cancellationStatusLabel" alignment="CENTER" layoutX="233.0" layoutY="164.0" prefHeight="63.0" prefWidth="144.0" text="Cancellation Status" />
      <Button layoutX="421.0" layoutY="183.0" mnemonicParsing="false" onAction="#confirmCancellationButtonOnAction" text="Confirm Cancellation" />
