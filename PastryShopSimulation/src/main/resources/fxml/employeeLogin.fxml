<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="common.EmployeeLoginController">
   <children>
      <Label layoutX="149.0" layoutY="127.0" text="Name : " />
      <Label layoutX="140.0" layoutY="165.0" text="Password : " />
      <TextField fx:id="employeeLoginName" layoutX="225.0" layoutY="123.0" />
      <TextField fx:id="employeeLoginPass" layoutX="225.0" layoutY="161.0" />
      <Button layoutX="517.0" layoutY="341.0" mnemonicParsing="false" onAction="#backButtonOnAction" text="Back" />
      <Button layoutX="274.0" layoutY="225.0" mnemonicParsing="false" onAction="#loginButtonOnAction" text="Login" />
   </children>
</AnchorPane>
